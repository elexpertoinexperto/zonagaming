---
import '../styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import BestSellers from '../components/BestSellers.astro';
import Comparador from '../components/Comparador.astro';
import productos from '../data/productos.json';

// Total de productos del catálogo, redondeado a la decena inferior (+360, +370…)
const totalComponentes = Math.floor(Object.values(productos).reduce((n: number, l: any) => n + l.length, 0) / 10) * 10;

const tg  = (productos['tarjetas-graficas'] as any[]);
const cpu = (productos['procesadores'] as any[]);
const ram = (productos['memoria-ram'] as any[]);

const categories = [
  { label: 'Tarjetas gráficas', slug: '/tarjetas-graficas/', icon: 'gpu', description: 'Potencia visual para gaming y edición.' },
  { label: 'Procesadores', slug: '/procesadores/', icon: 'cpu', description: 'CPU para multitarea y rendimiento extremo.' },
  { label: 'Memoria RAM', slug: '/memoria-ram/', icon: 'ram', description: 'Velocidad y capacidad para tus builds.' },
  { label: 'SSD', slug: '/ssd/', icon: 'ssd', description: 'Almacenamiento rápido para juegos y programas.' },
  { label: 'Fuentes de poder', slug: '/fuentes-de-poder/', icon: 'psu', description: 'Energía estable y eficiente para tu PC.' },
  { label: 'Refrigeración líquida', slug: '/refrigeracion-liquida/', icon: 'aio', description: 'Enfriamiento silencioso y de alto rendimiento.' },
  { label: 'Refrigeración normal', slug: '/refrigeracion-normal/', icon: 'fan', description: 'Ventiladores confiables para tu torre.' },
  { label: 'Gabinetes gamer', slug: '/gabinetes-gamer/', icon: 'box', description: 'Estética, flujo de aire y espacio para tu setup.' },
  { label: 'Teclados', slug: '/teclados/', icon: 'keyboard', description: 'Periféricos mecánicos y RGB para cada tipo de jugador.' },
  { label: 'Mouse', slug: '/mouse/', icon: 'mouse', description: 'Precisión y ergonomía para juegos competitivos.' },
  { label: 'Audífonos', slug: '/audifonos/', icon: 'audio', description: 'Sonido inmersivo para tus partidas y streaming.' },
  { label: 'Monitores', slug: '/monitores/', icon: 'monitor', description: 'Alta tasa de refresco, 4K, OLED y ultrawide para ganar.' },
];

const bestSellerProducts = [
  {
    id: 1,
    name: tg.find((p: any) => p.id === 1)?.nombre || '',
    description: tg.find((p: any) => p.id === 1)?.descripcion || '',
    price: `$${(tg.find((p: any) => p.id === 1)?.precio ?? 0).toFixed(2)} USD`,
    imageUrl: tg.find((p: any) => p.id === 1)?.imagenUrl || '/placeholder-product.svg',
    detailHref: `/tarjetas-graficas/${tg.find((p: any) => p.id === 1)?.slug}-1/`,
    amazonHref: tg.find((p: any) => p.id === 1)?.enlaceAmazon || '',
  },
  {
    id: 2,
    name: cpu.find((p: any) => p.id === 1)?.nombre || '',
    description: cpu.find((p: any) => p.id === 1)?.descripcion || '',
    price: `$${(cpu.find((p: any) => p.id === 1)?.precio ?? 0).toFixed(2)} USD`,
    imageUrl: cpu.find((p: any) => p.id === 1)?.imagenUrl || '/placeholder-product.svg',
    detailHref: `/procesadores/${cpu.find((p: any) => p.id === 1)?.slug}-1/`,
    amazonHref: cpu.find((p: any) => p.id === 1)?.enlaceAmazon || '',
  },
  {
    id: 3,
    name: ram.find((p: any) => p.id === 1)?.nombre || '',
    description: ram.find((p: any) => p.id === 1)?.descripcion || '',
    price: `$${(ram.find((p: any) => p.id === 1)?.precio ?? 0).toFixed(2)} USD`,
    imageUrl: ram.find((p: any) => p.id === 1)?.imagenUrl || '/placeholder-product.svg',
    detailHref: `/memoria-ram/${ram.find((p: any) => p.id === 1)?.slug}-1/`,
    amazonHref: ram.find((p: any) => p.id === 1)?.enlaceAmazon || '',
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/logo-fondoblanco.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/logo-fondoblanco.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="es-CO" href="https://monckeygamer.com/" />
    <link rel="alternate" hreflang="en-US" href="https://monckeygamer.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://monckeygamer.com/" />
    <meta name="description" content="Componentes PC gamer al mejor precio: tarjetas gráficas, CPU, RAM, SSD y más. Calidad premium y envío Amazon. ¡Arma tu setup!" />
    <title>Componentes PC Gamer | Monckey Gamer</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "name": "Monckey Gamer",
      "url": "https://monckeygamer.com/",
      "description": "Tienda online de componentes PC para gaming: tarjetas gráficas, procesadores, memoria RAM, SSD y periféricos al mejor precio con envío Amazon.",
      "email": "contacto@monckeygamer.com",
      "inLanguage": "es",
      "currenciesAccepted": "USD",
      "paymentAccepted": "Amazon",
      "priceRange": "$$",
      "hasMap": false,
      "sameAs": []
    })} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5C73Q4ZW');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5C73Q4ZW"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="page">
      <Header />

      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <div class="hero-emblem">
            <span class="em-glow"></span>
            <span class="em-pulse"></span>
            <span class="em-pulse em-pulse-2"></span>
            <svg class="em-ring em-ring-a" viewBox="0 0 400 400" fill="none">
              <defs>
                <linearGradient id="em-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#7cffcb" />
                  <stop offset="1" stop-color="#1bb7ff" />
                </linearGradient>
              </defs>
              <circle cx="200" cy="200" r="190" stroke="url(#em-grad)" stroke-width="2" stroke-dasharray="2 11" stroke-linecap="round" />
            </svg>
            <svg class="em-ring em-ring-b" viewBox="0 0 400 400" fill="none">
              <circle cx="200" cy="200" r="190" stroke="url(#em-grad)" stroke-width="1.5" stroke-dasharray="70 22 6 22" stroke-linecap="round" />
            </svg>
            <div class="em-orbit">
            <span class="em-chip" style="left: 50.00%; top: 4.00%; --d: 0s"><span class="em-chip-in"><CategoryIcon name="gpu" /></span></span>
            <span class="em-chip" style="left: 89.84%; top: 27.00%; --d: -0.9s"><span class="em-chip-in"><CategoryIcon name="cpu" /></span></span>
            <span class="em-chip" style="left: 89.84%; top: 73.00%; --d: -1.8s"><span class="em-chip-in"><CategoryIcon name="ram" /></span></span>
            <span class="em-chip" style="left: 50.00%; top: 96.00%; --d: -2.7s"><span class="em-chip-in"><CategoryIcon name="ssd" /></span></span>
            <span class="em-chip" style="left: 10.16%; top: 73.00%; --d: -3.6s"><span class="em-chip-in"><CategoryIcon name="mouse" /></span></span>
            <span class="em-chip" style="left: 10.16%; top: 27.00%; --d: -4.5s"><span class="em-chip-in"><CategoryIcon name="keyboard" /></span></span>
            </div>
            <img class="em-logo" src="/logo.png" alt="" width="552" height="552" decoding="async" />
          </div>
        </div>

        <div class="hero-copy" id="hero-copy">
          <h1>Componentes PC<br /><em>Tienda Gamer</em></h1>
          <p class="hero-copy-description">Equipos y componentes que elevan tu rendimiento al siguiente nivel</p>
          <p>Catálogo curado de piezas para armado de PC — tarjetas gráficas, fuentes, teclados mecánicos y enfriamiento líquido. Velocidad máxima y estilo gamer real.</p>
          <div class="hero-actions">
            <a class="btn" href="#coleccion">Los Más Vendidos</a>
            <a class="btn-secondary" href="#categorias">Explorar categorías</a>
          </div>
          <ul class="hero-facts">
            <li><strong>+{totalComponentes}</strong> componentes para gaming</li>
            <li>Disponible 24 h</li>
            <li>Garantía directa con Amazon</li>
          </ul>
        </div>
      </section>

      <section id="categorias" class="categories">
        <div class="section-title">
          <h2>Encuentra el componente ideal</h2>
        </div>
        <div class="category-grid">
          {categories.map((category) => (
            <a class="category-card" href={category.slug}>
              <span class="category-icon">
                <CategoryIcon name={category.icon} />
              </span>
              <div>
                <h3>{category.label}</h3>
                <p>{category.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <BestSellers
        id="coleccion"
        title="Los más vendidos"        
        products={bestSellerProducts}
      />

      <Comparador />

      <section id="ventajas" class="features">
        <div class="section-title">
          <h2>Ventajas del setup gamer</h2>
        </div>
        <div class="feature-list">
          <div class="feature-item">
            <div>1</div>
            <div class="feature-content">
              <strong>Componetes de Alta Calidad</strong>
              <p>Aquí encontrarás los mejores componentes para tu setup gamer. y los podrás comprar a traves de Amazon.</p>
            </div>
          </div>
          <div class="feature-item">
            <div>2</div>
            <div class="feature-content">
              <strong>Calidad premium</strong>
              <p>Seleccionamos componentes de marcas reconocidas con rendimiento estable y duradero.</p>
            </div>
          </div>
          <div class="feature-item">
            <div>3</div>
            <div class="feature-content">
              <strong>Blogs interesantes</strong>
              <p>Publicaré un blog interesante con consejos y actualizaciones sobre el mundo del gaming.</p>
            </div>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  </body>
</html>
