---
// Subcategorías (filtros) de esta categoría: /fuentes-de-poder/<filtro>/ — ver src/lib/filtros.mjs
import FiltroPagina from '../../components/FiltroPagina.astro';
import { FILTROS } from '../../lib/filtros-catalogo';

export function getStaticPaths() {
  return FILTROS['fuentes-de-poder'].map((f) => ({ params: { filtro: f.slugEs } }));
}

const { filtro } = Astro.params;
---

<FiltroPagina catKey="fuentes-de-poder" slug={filtro!} lang="es" />
