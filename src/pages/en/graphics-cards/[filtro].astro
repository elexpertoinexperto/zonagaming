---
// Subcategories (filters) for this category: /en/graphics-cards/<filter>/ — see src/lib/filtros.mjs
import FiltroPagina from '../../../components/FiltroPagina.astro';
import { FILTROS } from '../../../lib/filtros-catalogo';

export function getStaticPaths() {
  return FILTROS['tarjetas-graficas'].map((f) => ({ params: { filtro: f.slugEn } }));
}

const { filtro } = Astro.params;
---

<FiltroPagina catKey="tarjetas-graficas" slug={filtro!} lang="en" />
