---
import TextoSEO from '../../../components/TextoSEO.astro';
import { seoDe } from '../../../lib/seo-keywords.mjs';
import SiteLayout from '../../../components/SiteLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FiltrosNav from '../../../components/FiltrosNav.astro';
import ProductCard from '../../../components/ProductCard.astro';
import BestSellers from '../../../components/BestSellers.astro';
import Comparador from '../../../components/Comparador.astro';
import FAQ from '../../../components/FAQ.astro';
import SchemaCategoria from '../../../components/SchemaCategoria.astro';
import { conImagenPrimero } from '../../../lib/orden.mjs';
import ErroresComunes from '../../../components/ErroresComunes.astro';
import CategoriasRelacionadas from '../../../components/CategoriasRelacionadas.astro';
import EnlazadoInterno from '../../../components/EnlazadoInterno.astro';
import { faqEn } from '../../../data/faq';
import productos from '../../../data/productos-en.json';
import { CATS_EN } from '../../../i18n/en';

const catKey = 'audifonos';
const categoria = 'headsets';
const cat = CATS_EN[catKey];
// SEO por keyword (volumen real): title, H1, meta, introducción y texto salen de src/data/seo-keywords.json
const seo = seoDe('/en/headsets/')!;
const productsData = conImagenPrimero(productos[catKey] as any[]);

const bestSellerProducts = productsData.slice(0, 3).map((p) => ({
  id: p.id,
  name: p.nombre,
  description: p.descripcion,
  price: `$${p.precio.toFixed(2)} USD`,
  imageUrl: p.imagenUrl,
  detailHref: `/en/${categoria}/${p.slug}-${p.id}/`,
  amazonHref: p.enlaceAmazon,
}));
---

<SiteLayout title={seo.title} description={seo.meta} robots="index, follow">
  <section class="category-hero">
    <Breadcrumb catKey="audifonos" lang="en" />
    <h1>{seo.h1}</h1>
    <p class="category-description">{seo.intro}</p>
    <div class="category-meta">
      <span>{productsData.length} products available</span>
      <span>Verified stock and secure shipping</span>
    </div>
  </section>

  <FiltrosNav catKey="audifonos" lang="en" />

  <section class="product-grid">
    {productsData.map((product) => (
      <ProductCard lang="en" product={{
        id: product.id,
        name: product.nombre,
        price: `$${product.precio.toFixed(2)} USD`,
        description: product.descripcion,
        imageUrl: product.imagenUrl,
        detailHref: `/en/${categoria}/${product.slug}-${product.id}/`,
        amazonHref: product.enlaceAmazon,
        marca: (product as any).marca,
      }}/>
    ))}
  </section>

  <SchemaCategoria catKey={catKey} lang="en" items={productsData} />

  <Comparador categoriaFija={catKey} lang="en" />

  <TextoSEO h2={seo.h2} parrafos={seo.p} />

  <EnlazadoInterno cat="audifonos" lang="en">
    <section class="category-buying-guide">
    <h2>{cat.guide.title}</h2>
    <p>{cat.guide.intro}</p>
    <ul>
      {cat.guide.bullets.map((item) => (
        <li><strong>{item.b}</strong> {item.t}</li>
      ))}
    </ul>
    <p>{cat.guide.outro}</p>
  </section>
    <ErroresComunes catKey="audifonos" lang="en" />
  </EnlazadoInterno>

  <BestSellers
    id={`best-selling-${categoria}`}
    eyebrow="Top sellers"
    title={cat.bsTitle}
    products={bestSellerProducts}
  />
  <CategoriasRelacionadas catKey="audifonos" lang="en" />
  <EnlazadoInterno cat="audifonos" lang="en">
    <FAQ title="Frequently Asked Questions" items={faqEn['audifonos']} />
  </EnlazadoInterno>
</SiteLayout>
