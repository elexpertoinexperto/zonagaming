---
// Subcategories (filters) for this category: /en/power-supplies/<filter>/ — see src/lib/filtros.mjs
import FiltroPagina from '../../../components/FiltroPagina.astro';
import { FILTROS } from '../../../lib/filtros-catalogo';

export function getStaticPaths() {
  return FILTROS['fuentes-de-poder'].map((f) => ({ params: { filtro: f.slugEn } }));
}

const { filtro } = Astro.params;
---

<FiltroPagina catKey="fuentes-de-poder" slug={filtro!} lang="en" />
