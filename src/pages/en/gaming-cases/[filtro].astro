---
// Subcategories (filters) for this category: /en/gaming-cases/<filter>/ — see src/lib/filtros.mjs
import FiltroPagina from '../../../components/FiltroPagina.astro';
import { FILTROS } from '../../../lib/filtros-catalogo';

export function getStaticPaths() {
  return FILTROS['gabinetes-gamer'].map((f) => ({ params: { filtro: f.slugEn } }));
}

const { filtro } = Astro.params;
---

<FiltroPagina catKey="gabinetes-gamer" slug={filtro!} lang="en" />
