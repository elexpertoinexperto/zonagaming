---
// Subcategories (filters) for this category: /en/air-cooling/<filter>/ — see src/lib/filtros.mjs
import FiltroPagina from '../../../components/FiltroPagina.astro';
import { FILTROS } from '../../../lib/filtros-catalogo';

export function getStaticPaths() {
  return FILTROS['refrigeracion-normal'].map((f) => ({ params: { filtro: f.slugEn } }));
}

const { filtro } = Astro.params;
---

<FiltroPagina catKey="refrigeracion-normal" slug={filtro!} lang="en" />
