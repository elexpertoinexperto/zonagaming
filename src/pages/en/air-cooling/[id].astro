---
import SiteLayout from '../../../components/SiteLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductoDetalle from '../../../components/ProductoDetalle.astro';
import productos from '../../../data/productos-en.json';
import { nombreCortoUnico } from '../../../lib/seo.mjs';
import { CATS_EN } from '../../../i18n/en';

export function getStaticPaths() {
  const productosCategoria = productos['refrigeracion-normal'] as any[];
  return productosCategoria.map((p) => ({
    params: { id: `${p.slug}-${p.id}` }
  }));
}

const { id } = Astro.params;
const catKey = 'refrigeracion-normal';
const categoria = 'air-cooling';
const cat = CATS_EN[catKey];
const productosCategoria = productos[catKey] as any[];
// Extraer el ID numérico del final del parámetro (slug-id)
const numeroId = parseInt(id!.split('-').pop()!);
const producto = productosCategoria.find((p) => p.id === numeroId);

if (!producto) {
  return Astro.redirect(`/en/${categoria}/`);
}

const metaDescription = `${nombreCortoUnico(producto, productosCategoria, 58)} at the best price at Monckey Gamer. Specs, reviews and Amazon shipping.`;
---

<SiteLayout title={`${producto.nombre} | Monckey Gamer`} description={metaDescription} robots="index, follow">
  <div class="producto-header">
    <Breadcrumb catKey="refrigeracion-normal" lang="en" current={producto.nombre} />
  </div>

  <ProductoDetalle
    lang="en"
    nombre={producto.nombre}
    descripcion={producto.descripcion}
    especificaciones={producto.especificaciones}
    precio={producto.precio}
    enlaceAmazon={producto.enlaceAmazon}
    imagenPath={(producto as any).imagenUrl || '/placeholder-product.svg'}
    marca={(producto as any).marca}
  />
</SiteLayout>

<style>
  .producto-header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 0 22px;
  }

  .pdp-seo-context {
    max-width: 1200px;
    margin: 72px auto 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--line);
  }

  .pdp-seo-context h2 {
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 14px;
  }

  .pdp-seo-context p {
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 0.95rem;
    margin: 0 0 12px;
    max-width: 78ch;
  }

  .pdp-seo-context a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
