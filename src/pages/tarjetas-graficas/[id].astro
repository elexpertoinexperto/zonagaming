---
import SiteLayout from '../../components/SiteLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductoDetalle from '../../components/ProductoDetalle.astro';
import JuegosCompatibles from '../../components/JuegosCompatibles.astro';
import productos from '../../data/productos.json';
import { nombreCortoUnico } from '../../lib/seo.mjs';

export function getStaticPaths() {
  const productosCategoria = productos['tarjetas-graficas' as keyof typeof productos];
  return productosCategoria.map((p: any) => ({
    params: { id: `${p.slug}-${p.id}` }
  }));
}

const { id } = Astro.params;
const categoria = 'tarjetas-graficas';
const productosCategoria = productos[categoria as keyof typeof productos];
// Extraer el ID numérico del final del parámetro (slug-id)
const numeroId = parseInt(id!.split('-').pop()!);
const producto = productosCategoria.find((p: any) => p.id === numeroId);

if (!producto) {
  return Astro.redirect('/tarjetas-graficas');
}

const nombreCorto = nombreCortoUnico(producto, productosCategoria as any[], 50);
const metaDescription = `${nombreCorto} — tarjeta gráfica para PC al mejor precio. Specs, opiniones y compra con envío Amazon en Monckey Gamer.`;
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://monckeygamer.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tarjetas Gráficas", "item": "https://monckeygamer.com/tarjetas-graficas/" },
    { "@type": "ListItem", "position": 3, "name": producto.nombre, "item": `https://monckeygamer.com/tarjetas-graficas/${id}/` }
  ]
};
---

<SiteLayout title={`${producto.nombre} | Tarjeta Gráfica para PC | Monckey Gamer`} description={metaDescription} robots="index, follow" schema={breadcrumb}>
  <div class="producto-header">
    <Breadcrumb catKey="tarjetas-graficas" lang="es" current={producto.nombre} />
  </div>

  <ProductoDetalle
    nombre={producto.nombre}
    descripcion={producto.descripcion}
    especificaciones={producto.especificaciones}
    precio={producto.precio}
    enlaceAmazon={producto.enlaceAmazon}
    imagenPath={(producto as any).imagenUrl || '/placeholder-product.svg'}
    marca={(producto as any).marca}
  />

  <JuegosCompatibles
    categoria="tarjetas-graficas"
    productoId={numeroId}
    productoNombre={producto.nombre}
  />

  <section class="pdp-seo-context">
    <h2>¿Por qué elegir esta tarjeta gráfica para tu PC?</h2>
    <p>
      La <strong>{producto.nombre}</strong> es una tarjeta gráfica diseñada para gamers que buscan rendimiento real sin pagar de más.
      Como tarjeta de video para PC, ofrece la potencia necesaria para jugar con fluidez y calidad en los títulos más exigentes.
    </p>
    <p>
      Si estás buscando tarjetas gráficas para PC que equilibren precio y rendimiento, esta opción está disponible con envío directo desde Amazon,
      con garantía oficial y devoluciones sin complicaciones. Compara con otras tarjetas de video en nuestro
      <a href="/tarjetas-graficas/">catálogo completo de tarjetas gráficas</a>.
    </p>
  </section>
</SiteLayout>

<style>
  .producto-header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 0 22px;
  }

  .pdp-seo-context {
    max-width: 1200px;
    margin: 72px auto 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--line);
  }

  .pdp-seo-context h2 {
    font-size: 1.15rem;
    color: var(--text);
    margin: 0 0 14px;
  }

  .pdp-seo-context p {
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 0.95rem;
    margin: 0 0 12px;
    max-width: 78ch;
  }

  .pdp-seo-context a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
