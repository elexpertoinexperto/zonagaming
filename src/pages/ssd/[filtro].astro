---
// Subcategorías (filtros) de esta categoría: /ssd/<filtro>/ — ver src/lib/filtros.mjs
import FiltroPagina from '../../components/FiltroPagina.astro';
import { FILTROS } from '../../lib/filtros-catalogo';

export function getStaticPaths() {
  return FILTROS['ssd'].map((f) => ({ params: { filtro: f.slugEs } }));
}

const { filtro } = Astro.params;
---

<FiltroPagina catKey="ssd" slug={filtro!} lang="es" />
