---
// Plantilla de TODOS los artículos del blog (español e inglés).
// Cabecera editorial, índice lateral que sigue la lectura (en escritorio) o desplegable (en móvil),
// barra de progreso, cuerpo con tipografía de lectura, bloque final de llamada a la acción y "más guías".
import SiteLayout from './SiteLayout.astro';
import { ARTICULOS_ES } from '../data/blog-es';
import { ARTICLES_EN } from '../i18n/en';

interface Props {
  lang?: 'es' | 'en';
  title: string;
  description: string;
  fecha: string;
  dateISO: string;
  tiempoLectura: string;
  secciones: { id: string; label: string }[];
  tag: string;
  h1: string;
  cta: { titulo: string; texto: string; boton: string; href: string };
}

const { lang = 'es', title, description, fecha, dateISO, tiempoLectura, secciones, tag, h1, cta } = Astro.props;
const isEn = lang === 'en';
const site = 'https://monckeygamer.com';
const rutaActual = Astro.url.pathname;
const blogHref = isEn ? '/en/blog/' : '/blog/';

const t = isEn
  ? { home: 'Home', blog: 'Blog', toc: 'In this article', by: 'Monckey Gamer', more: 'Keep reading', all: 'All guides', read: 'read', progreso: 'Reading progress', aside: 'Gamer guide' }
  : { home: 'Inicio', blog: 'Blog', toc: 'En este artículo', by: 'Monckey Gamer', more: 'Sigue leyendo', all: 'Todas las guías', read: 'de lectura', progreso: 'Progreso de lectura', aside: 'Guía gamer' };

// "Más guías": primero las de la misma categoría, luego el resto; nunca el propio artículo
const lista: { titulo: string; resumen: string; href: string; tag: string; tiempoLectura: string }[] = isEn ? ARTICLES_EN : ARTICULOS_ES;
const otros = lista.filter((a) => a.href !== rutaActual);
const mismoTag = otros.filter((a) => a.tag === tag);
const relacionados = [...mismoTag, ...otros.filter((a) => a.tag !== tag)].slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: `${site}${isEn ? '/en/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: t.blog, item: `${site}${blogHref}` },
    { '@type': 'ListItem', position: 3, name: h1, item: `${site}${rutaActual}` },
  ],
};
---

<SiteLayout title={`${title} | Monckey Gamer`} description={description} robots="index, follow" schema={schema} article={{ title, dateISO }}>
  <div class="post-progress" aria-hidden="true"><span id="post-progress-bar"></span></div>

  <article class="post">
    <ol class="breadcrumb" aria-label={isEn ? 'Breadcrumb' : 'Migas de pan'}>
      <li><a href={isEn ? '/en/' : '/'}>{t.home}</a></li>
      <li><a href={blogHref}>{t.blog}</a></li>
      <li aria-current="page" class="breadcrumb-actual">{h1}</li>
    </ol>

    <div class="post-hero">
      <a class="post-chip" href={blogHref}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5z"/></svg>
        {tag}
      </a>
      <h1>{h1}</h1>
      <p class="post-lead"><slot name="lead" /></p>
      <div class="post-meta">
        <img class="post-meta-logo" src="/logo.png" alt="" width="28" height="28" />
        <span class="post-meta-by">{t.by}</span>
        <span class="post-meta-dot"></span>
        <time datetime={dateISO}>{fecha}</time>
        <span class="post-meta-dot"></span>
        <span>{tiempoLectura}</span>
      </div>
    </div>

    <div class="post-layout">
      <div class="post-main">
        <details class="post-toc-m">
          <summary>{t.toc}</summary>
          <ol>
            {secciones.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
          </ol>
        </details>

        <div class="post-body">
          <slot />
        </div>

        <aside class="post-cta">
          <div>
            <h3>{cta.titulo}</h3>
            <p>{cta.texto}</p>
          </div>
          <a class="btn" href={cta.href}>{cta.boton}</a>
        </aside>

        <section class="post-more" aria-labelledby="post-more-title">
          <div class="post-more-head">
            <h2 id="post-more-title">{t.more}</h2>
            <a href={blogHref}>{t.all} →</a>
          </div>
          <div class="post-more-grid">
            {relacionados.map((a) => (
              <a class="post-more-card" href={a.href}>
                <span class="post-more-tag">{a.tag}</span>
                <strong>{a.titulo}</strong>
                <span class="post-more-meta">{a.tiempoLectura} {t.read}</span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="post-aside" aria-label={t.toc}>
        <nav class="post-toc" aria-label={t.toc}>
          <span class="post-toc-title">{t.toc}</span>
          <ol>
            {secciones.map((s) => <li><a href={`#${s.id}`} data-sec={s.id}>{s.label}</a></li>)}
          </ol>
        </nav>
      </aside>
    </div>
  </article>
</SiteLayout>

<script>
  // Barra de progreso de lectura + resalte de la sección visible en el índice lateral
  const barra = document.getElementById('post-progress-bar');
  const body = document.querySelector('.post-body');
  let ticking = false;
  const pinta = () => {
    ticking = false;
    if (!barra || !body) return;
    const r = body.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.6;
    const hecho = Math.min(Math.max(-r.top + window.innerHeight * 0.2, 0), Math.max(total, 1));
    barra.style.transform = `scaleX(${Math.min(hecho / Math.max(total, 1), 1)})`;
  };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(pinta); } }, { passive: true });
  window.addEventListener('resize', pinta);
  pinta();

  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-toc a[data-sec]'));
  const secciones = enlaces.map((a) => document.getElementById(a.dataset.sec!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && secciones.length) {
    const visibles = new Set<string>();
    const io = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => (e.isIntersecting ? visibles.add(e.target.id) : visibles.delete(e.target.id)));
      const activa = secciones.find((s) => visibles.has(s.id))?.id;
      if (activa) enlaces.forEach((a) => a.classList.toggle('activo', a.dataset.sec === activa));
    }, { rootMargin: '-15% 0px -65% 0px' });
    secciones.forEach((s) => io.observe(s));
  }

  // En móvil, al elegir una sección se cierra el índice desplegable
  document.querySelectorAll('.post-toc-m a').forEach((a) => a.addEventListener('click', () => {
    (document.querySelector('.post-toc-m') as HTMLDetailsElement | null)?.removeAttribute('open');
  }));
</script>

<style is:global>
  /* ── Progreso de lectura ─────────────────────────────────── */
  .post-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 80;
    background: transparent;
    pointer-events: none;
  }

  .post-progress span {
    display: block;
    height: 100%;
    background: var(--brand-grad);
    transform: scaleX(0);
    transform-origin: left;
    box-shadow: 0 0 12px rgba(0, 255, 225, 0.55);
  }

  /* ── Cabecera del artículo ───────────────────────────────── */
  .post {
    max-width: 1100px;
    margin: 0 auto;
  }

  .post .breadcrumb { margin: 28px 0 0; flex-wrap: nowrap; }
  .post .breadcrumb li { flex: none; }
  .post .breadcrumb .breadcrumb-actual { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .post-hero {
    position: relative;
    max-width: 820px;
    padding: 34px 0 40px;
  }

  .post-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -70px -120px auto -120px;
    height: 360px;
    background:
      radial-gradient(ellipse 50% 60% at 18% 40%, rgba(124, 255, 203, 0.12), transparent 70%),
      radial-gradient(ellipse 40% 50% at 70% 30%, rgba(27, 183, 255, 0.1), transparent 70%);
    pointer-events: none;
  }

  .post-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(124, 255, 203, 0.3);
    background: rgba(124, 255, 203, 0.08);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.2s var(--ease);
  }

  .post-chip:hover { background: rgba(124, 255, 203, 0.16); }

  .post-hero h1 {
    margin: 20px 0 18px;
    font-size: clamp(2.1rem, 5.4vw, 3.7rem);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--text);
    overflow-wrap: break-word;
  }

  .post-lead {
    margin: 0 0 26px;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    color: var(--text-dim);
    font-size: 0.88rem;
  }

  .post-meta-logo { width: 28px; height: 28px; border-radius: 8px; }
  .post-meta-by { color: var(--text); font-weight: 500; }
  .post-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text-dim); }

  /* ── Rejilla: lectura + índice lateral ───────────────────── */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .post-main { min-width: 0; max-width: 740px; }
  .post-aside { display: none; }

  @media (min-width: 1100px) {
    .post-layout { grid-template-columns: minmax(0, 740px) 260px; justify-content: space-between; }
    .post-aside { display: block; position: sticky; top: 28px; align-self: start; }
    .post-toc-m { display: none; }
  }

  /* Índice lateral */
  .post-toc {
    padding: 4px 0 4px 18px;
    border-left: 1px solid var(--line);
  }

  .post-toc-title {
    display: block;
    margin-bottom: 14px;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .post-toc ol,
  .post-toc-m ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .post-toc a {
    position: relative;
    display: block;
    padding: 7px 0;
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .post-toc a:hover { color: var(--text); }

  .post-toc a.activo {
    color: var(--accent);
    font-weight: 500;
    transform: translateX(4px);
  }

  .post-toc a.activo::before {
    content: '';
    position: absolute;
    left: -19px;
    top: 50%;
    width: 2px;
    height: 70%;
    translate: 0 -50%;
    background: var(--brand-grad);
    border-radius: 2px;
  }

  /* Índice desplegable (móvil y tablet) */
  .post-toc-m {
    margin: 0 0 28px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
  }

  .post-toc-m summary {
    padding: 14px 18px;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .post-toc-m summary::-webkit-details-marker { display: none; }
  .post-toc-m summary::after { content: '+'; color: var(--accent); font-size: 1.3rem; line-height: 1; }
  .post-toc-m[open] summary::after { content: '–'; }
  .post-toc-m ol { padding: 0 18px 14px; }
  .post-toc-m a { display: block; padding: 8px 0; color: var(--text-muted); font-size: 0.94rem; text-decoration: none; }
  .post-toc-m a:hover { color: var(--accent); }

  /* ── Cuerpo del artículo ─────────────────────────────────── */
  .post-body { font-size: 1.05rem; }

  .post-body section {
    margin: 0 0 52px;
    scroll-margin-top: 28px;
  }

  .post-body h2 {
    margin: 0 0 18px;
    padding: 0;
    border: 0;
    font-size: clamp(1.5rem, 2.6vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .post-body h2::after {
    content: '';
    display: block;
    width: 36px;
    height: 3px;
    margin-top: 12px;
    border-radius: 3px;
    background: var(--brand-grad);
  }

  .post-body p {
    margin: 0 0 18px;
    color: var(--text-muted);
    line-height: 1.85;
  }

  .post-body strong { color: var(--text); font-weight: 600; }
  .post-body em { color: var(--text); }

  .post-body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(124, 255, 203, 0.4);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .post-body a:hover { text-decoration-color: var(--accent); color: #fff; }

  .post-body code {
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line);
    color: var(--text);
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.88em;
  }

  /* Listas con puntos de marca */
  .post-list {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .post-list li {
    position: relative;
    padding-left: 28px;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .post-list li::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--brand-grad);
    rotate: 45deg;
  }

  /* Pasos numerados */
  .post-steps {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    counter-reset: paso;
    display: grid;
    gap: 14px;
  }

  .post-steps li {
    position: relative;
    padding: 14px 16px 14px 56px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    line-height: 1.7;
    counter-increment: paso;
  }

  .post-steps li::before {
    content: counter(paso);
    position: absolute;
    left: 14px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand-grad);
    color: #05070b;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* Tablas */
  .post-table-wrap {
    margin: 0 0 22px;
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .post-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }

  .post-table th {
    padding: 14px 20px;
    text-align: left;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(124, 255, 203, 0.06);
    border-bottom: 1px solid var(--line);
  }

  .post-table td {
    padding: 14px 20px;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .post-table tbody tr:nth-child(even) td { background: rgba(255, 255, 255, 0.015); }
  .post-table tbody tr:last-child td { border-bottom: 0; }
  .post-table td:first-child { color: var(--text); font-weight: 500; }

  /* Nota / consejo */
  .post-body .post-note {
    position: relative;
    margin: 0 0 22px;
    padding: 16px 20px 16px 52px;
    border-radius: 14px;
    border: 1px solid rgba(27, 183, 255, 0.22);
    background: rgba(27, 183, 255, 0.07);
    color: var(--text-muted);
    font-size: 0.97rem;
    line-height: 1.7;
  }

  .post-body .post-note::before {
    content: 'i';
    position: absolute;
    left: 18px;
    top: 16px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid #1bb7ff;
    color: #1bb7ff;
    font-size: 0.78rem;
    font-weight: 700;
    font-style: italic;
  }

  /* ── Llamada a la acción final ───────────────────────────── */
  .post-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 56px 0 0;
    padding: 28px 32px;
    border-radius: 22px;
    border: 1px solid rgba(124, 255, 203, 0.22);
    background:
      radial-gradient(ellipse 60% 120% at 100% 0%, rgba(0, 255, 225, 0.12), transparent 70%),
      var(--navy);
  }

  .post-cta h3 { margin: 0 0 6px; font-size: 1.35rem; color: var(--text); }
  .post-cta p { margin: 0; color: var(--text-muted); line-height: 1.6; }
  .post-cta .btn { flex: none; white-space: nowrap; }

  /* ── Más guías ───────────────────────────────────────────── */
  .post-more { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--line); }

  .post-more-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .post-more-head h2 { margin: 0; font-size: 1.35rem; }
  .post-more-head a { color: var(--accent); font-size: 0.92rem; text-decoration: none; }
  .post-more-head a:hover { text-decoration: underline; }

  .post-more-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .post-more-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .post-more-card:hover {
    border-color: rgba(124, 255, 203, 0.45);
    background: rgba(124, 255, 203, 0.06);
    transform: translateY(-2px);
  }

  .post-more-card strong { font-size: 0.98rem; line-height: 1.35; font-weight: 600; flex: 1; }
  .post-more-tag { color: var(--accent); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .post-more-meta { color: var(--text-dim); font-size: 0.82rem; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 860px) {
    .post-more-grid { grid-template-columns: 1fr; }
    .post-cta { flex-direction: column; align-items: flex-start; padding: 24px; }
    .post-cta .btn { width: 100%; }
  }

  @media (max-width: 640px) {
    .post-hero { padding: 22px 0 28px; }
    .post-hero::before { inset: -40px -24px auto -24px; }
    .post-body { font-size: 1rem; }
    .post-body section { margin-bottom: 40px; }
    .post-table { font-size: 0.85rem; }
    .post-table th { padding: 11px 12px; font-size: 0.68rem; }
    .post-table td { padding: 11px 12px; }
    .post-steps li { padding-left: 52px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-toc a.activo { transform: none; }
  }
</style>
