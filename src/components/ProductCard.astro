---
import { altProducto, claveDeRuta } from '../lib/alt-texto.mjs';
import variantes from '../data/imagenes-variantes.json';

type ProductCardData = {
  id?: number | string;
  name: string;
  description: string;
  price: string;
  imageUrl?: string;
  detailHref?: string;
  amazonHref?: string;
  marca?: string;
};

// pos = lugar de la tarjeta en su listado (0 = la primera). Sin pos (p. ej. «Más vendidos» de la portada, que queda bajo el pliegue) siempre lazy.
const { product, lang = 'es', pos } = Astro.props as { product: ProductCardData; lang?: 'es' | 'en'; pos?: number };
// Carga de la imagen: lo que se ve al abrir la página va «eager» y el resto «lazy» (web.dev: no hacer lazy lo que está en el primer pantallazo).
// El HTML no distingue dispositivo: la primera fila de escritorio son 4 tarjetas (en móvil solo la 1.ª asoma, pero las 2.ª–3.ª entran en la
// distancia de precarga del navegador de todas formas, así que eager no les cuesta nada extra).
const PRIMERA_FILA = 4;
const eager = typeof pos === 'number' && pos < PRIMERA_FILA;
const tDetails = lang === 'en' ? 'Details' : 'Detalles';
// Versiones por tamaño (tools/optimizar-fotos-producto.mjs): la tarjeta muestra la foto a ~260–340 px, así que el navegador baja la de 480 px
// salvo que la pantalla tenga mucha densidad (móvil retina → la grande). Las fotos sin variante (ya pequeñas, SVG o externas) van tal cual.
const variante = (variantes as Record<string, { w: number; s: string }>)[product.imageUrl ?? ''];
// alt = keyword principal de la categoría (la del H1) + nombre; la categoría sale del enlace a la ficha
const hrefFicha = product.detailHref ?? '';
// Casilla «Comparar»: categoría e id salen del enlace a la ficha (/categoria/slug-ID/); ver src/scripts/comparar.ts
const cmpCat = claveDeRuta(hrefFicha);
const cmpId = Number((hrefFicha.match(/-([0-9]+)[/]$/) ?? [])[1]);
const tCompare = (hrefFicha.startsWith('/en/') ? 'en' : lang) === 'en' ? 'Compare' : 'Comparar';
const altImagen = altProducto(claveDeRuta(hrefFicha), product.name, hrefFicha.startsWith('/en/') ? 'en' : lang);
---

<article class="product-card">
  <div class="product-card-content">
    <div>
      {product.marca && <span class="brand-tag">{product.marca}</span>}
      <h2>{product.detailHref ? <a href={product.detailHref}>{product.name}</a> : product.name}</h2>
      <div class="product-card-image">
        <img
          src={product.imageUrl || '/placeholder-product.svg'}
          srcset={variante ? `${variante.s} 480w, ${product.imageUrl} ${variante.w}w` : undefined}
          sizes={variante ? '(max-width: 560px) 100vw, 300px' : undefined}
          alt={altImagen}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
      <p>{product.description}</p>
    </div>

    <div class="product-card-footer">
      <span>{product.price}</span>
       <div class="product-card-actions">
        {product.detailHref && (
          <a class="btn btn-small" href={product.detailHref}>{tDetails}</a>
        )}
      </div>
    </div>
    {cmpCat && cmpId > 0 && (
      <label class="cmp-check">
        <input type="checkbox" class="cmp-input" data-cat={cmpCat} data-id={cmpId} data-name={product.name} data-img={variante ? variante.s : (product.imageUrl || '/placeholder-product.svg')} data-href={hrefFicha} />
        <span>{tCompare}</span>
      </label>
    )}
  </div>
</article>

<style>
  .brand-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7cffcb;
    background: rgba(124, 255, 203, 0.1);
    border: 1px solid rgba(124, 255, 203, 0.3);
    border-radius: 4px;
    padding: 2px 8px;
    margin-bottom: 6px;
  }
</style>
