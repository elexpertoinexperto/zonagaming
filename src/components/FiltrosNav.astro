---
// Barra de subcategorías (filtros) de una categoría. Son enlaces normales a páginas estáticas
// (/tarjetas-graficas/para-1080p/), así funcionan sin JavaScript y Google los rastrea.
// Se usa en la página de la categoría (arriba) y en cada subcategoría (con la actual marcada).
import { FILTROS, GRUPOS, etiqueta, slugDe } from '../lib/filtros-catalogo';
import { SLUG_EN } from '../i18n/en';

const { catKey, lang = 'es', actual = '' } = Astro.props as { catKey: string; lang?: 'es' | 'en'; actual?: string };
const isEn = lang === 'en';
const lista = FILTROS[catKey] ?? [];
const base = isEn ? `/en/${SLUG_EN[catKey] ?? catKey}` : `/${catKey}`;

// Agrupa respetando el orden de definición
const grupos: { clave: string; filtros: typeof lista }[] = [];
for (const f of lista) {
  let g = grupos.find((x) => x.clave === f.grupo);
  if (!g) { g = { clave: f.grupo, filtros: [] }; grupos.push(g); }
  g.filtros.push(f);
}
const titulo = isEn ? 'Browse by subcategory' : 'Explora por subcategoría';
---

{lista.length > 0 && (
  <div class="filtros-nav" role="navigation" aria-label={titulo}>
    <p class="filtros-titulo">{titulo}</p>
    {grupos.map((g) => (
      <div class="filtros-grupo">
        <span class="filtros-grupo-nombre">{isEn ? (GRUPOS as any)[g.clave].en : (GRUPOS as any)[g.clave].es}</span>
        <ul>
          {g.filtros.map((f) => {
            const slug = slugDe(f, lang);
            const activo = slug === actual;
            return (
              <li>
                {activo ? (
                  <span class="chip chip-activo" aria-current="page">{etiqueta(f, lang)} <small>{f.total}</small></span>
                ) : (
                  <a class="chip" href={`${base}/${slug}/`}>{etiqueta(f, lang)} <small>{f.total}</small></a>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
)}

<style>
  .filtros-nav {
    margin: 0 0 28px;
    padding: 6px 20px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .filtros-titulo {
    margin: 0;
    padding: 14px 0 8px;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .filtros-grupo {
    display: grid;
    grid-template-columns: 148px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .filtros-grupo-nombre {
    color: var(--text-dim);
    font-size: 0.8rem;
    font-weight: 500;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.3;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .chip small {
    color: var(--text-dim);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }
  a.chip:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--text);
  }
  .chip-activo {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .chip-activo small { color: rgba(4, 18, 13, 0.7); }
  @media (max-width: 720px) {
    .filtros-nav { padding: 4px 14px; }
    .filtros-grupo { grid-template-columns: 1fr; gap: 6px; padding: 10px 0; }
    /* cada grupo es una fila deslizable en lugar de ocupar media pantalla */
    ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 -14px;
      padding: 2px 14px 6px;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 14px;
      scrollbar-width: none;
    }
    ul::-webkit-scrollbar { display: none; }
    .chip { scroll-snap-align: start; }
  }
</style>
