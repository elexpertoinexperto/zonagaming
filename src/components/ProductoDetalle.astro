---
interface Props {
  nombre: string;
  descripcion: string;
  especificaciones: Record<string, any>;
  precio: number;
  enlaceAmazon: string;
  imagenPath: string;
  lang?: 'es' | 'en';
  marca?: string;
}

const { nombre, descripcion, especificaciones, precio, enlaceAmazon, imagenPath, lang = 'es', marca } = Astro.props;
const isEn = lang === 'en';
const tSpecs = isEn ? 'Specifications' : 'Especificaciones';
const tPrice = isEn ? 'Price' : 'Precio';
const tAmazon = isEn ? 'View on Amazon' : 'Ver en Amazon';
---

<div class="producto-detalle">
  <div class="producto-contenedor">
    <div class="producto-imagenes">
      <img src={imagenPath} alt={nombre} class="producto-imagen" />
    </div>

    <div class="producto-info">
      {marca && <span class="brand-tag">{marca}</span>}
      <h1>{nombre}</h1>

      <p class="descripcion">{descripcion}</p>

      <div class="compra">
        <div class="compra-precio">
          <span class="precio-label">{tPrice}</span>
          <p class="precio">${precio.toFixed(2)} <small>USD</small></p>
        </div>
        <a href={enlaceAmazon} target="_blank" rel="noopener noreferrer" class="btn-amazon">
          {tAmazon}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <div class="especificaciones">
        <h2>{tSpecs}</h2>
        <dl>
          {Object.entries(especificaciones).filter(([, valor]) => String(valor).trim().toUpperCase() !== 'N/D').map(([clave, valor]) => (
            <div class="spec-fila">
              <dt class="clave">{clave}</dt>
              <dd class="valor">{valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</div>

<style>
  .producto-detalle {
    padding: 0;
  }

  .producto-contenedor {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
  }

  .producto-imagenes {
    position: sticky;
    top: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle at 50% 35%, #ffffff, #e9eef3);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .producto-imagen {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 28px;
    mix-blend-mode: multiply;
  }

  .brand-tag {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .producto-info h1 {
    margin: 0 0 16px;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .descripcion {
    margin: 0 0 28px;
    max-width: 62ch;
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .compra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding: 20px 22px;
    margin-bottom: 36px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .precio-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-dim);
    margin-bottom: 2px;
  }

  .precio {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .precio small {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-dim);
    letter-spacing: 0;
  }

  .btn-amazon {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: var(--r-md);
    background: var(--amazon);
    color: #1a1004;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
  }

  .btn-amazon:hover {
    background: #ffb04a;
    transform: translateY(-1px);
    box-shadow: 0 10px 26px -10px rgba(255, 159, 26, 0.7);
  }

  .especificaciones h2 {
    margin: 0 0 12px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .especificaciones dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .spec-fila {
    display: grid;
    grid-template-columns: minmax(120px, 0.8fr) minmax(0, 1.4fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .clave {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .valor {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .producto-contenedor {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .producto-imagenes {
      position: static;
      aspect-ratio: 4 / 3;
    }
    .compra { padding: 16px; }
    .precio { font-size: 1.8rem; }
    .btn-amazon { width: 100%; justify-content: center; }
  }
</style>
