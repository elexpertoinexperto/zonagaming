---
import CategoryIcon from './CategoryIcon.astro';
import { CATS_EN, UI_EN, SLUG_EN, toEnPath, toEsPath } from '../i18n/en';

// Idioma derivado de la URL: /en/... es inglés
const pathname = Astro.url.pathname;
const isEn = pathname === '/en' || pathname.startsWith('/en/');
const prefix = isEn ? '/en' : '';

// Rutas equivalentes para el selector de idioma (slugs de categoría traducidos)
const esPath = toEsPath(pathname);
const enPath = toEnPath(esPath);

const categoriesEs = [
  { label: 'Tarjetas gráficas', key: 'tarjetas-graficas', icon: 'gpu' },
  { label: 'Procesadores', key: 'procesadores', icon: 'cpu' },
  { label: 'Memoria RAM', key: 'memoria-ram', icon: 'ram' },
  { label: 'SSD', key: 'ssd', icon: 'ssd' },
  { label: 'Fuentes de poder', key: 'fuentes-de-poder', icon: 'psu' },
  { label: 'Refrigeración líquida', key: 'refrigeracion-liquida', icon: 'aio' },
  { label: 'Refrigeración normal', key: 'refrigeracion-normal', icon: 'fan' },
  { label: 'Gabinetes gamer', key: 'gabinetes-gamer', icon: 'box' },
  { label: 'Teclados', key: 'teclados', icon: 'keyboard' },
  { label: 'Mouse', key: 'mouse', icon: 'mouse' },
  { label: 'Audífonos', key: 'audifonos', icon: 'audio' },
  { label: 'Monitores', key: 'monitores', icon: 'monitor' },
];

const categories = categoriesEs.map((c) => ({
  label: isEn ? CATS_EN[c.key].label : c.label,
  slug: isEn ? `/en/${SLUG_EN[c.key]}/` : `/${c.key}/`,
  icon: c.icon,
}));

const t = {
  home: isEn ? UI_EN.nav.home : 'Inicio',
  components: isEn ? UI_EN.nav.components : 'Componentes',
  recommender: isEn ? UI_EN.nav.recommender : 'Recomendador',
  blog: isEn ? UI_EN.nav.blog : 'Blog',
  contact: isEn ? UI_EN.nav.contact : 'Contacto',
  search: isEn ? 'Search' : 'Buscar',
  searchPlaceholder: isEn ? 'Search products, brands or categories…' : 'Busca productos, marcas o categorías…',
  close: isEn ? 'Close' : 'Cerrar',
  hint: isEn ? 'to move · Enter to open · Esc to close' : 'para moverte · Enter para abrir · Esc para cerrar',
};

const iconoLupa = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>';
---

<header>
  <a href={isEn ? '/en/' : '/'} class="brand">
    <img src="/logo.png" alt="Monckey Gamer" class="brand-logo" />
    Monckey Gamer
  </a>
  <button class="search-btn search-btn--bar" type="button" data-abrir-buscador hidden aria-label={t.search} aria-haspopup="dialog" set:html={iconoLupa}></button>
  <button
    class="menu-toggle"
    id="mobile-menu-toggle"
    type="button"
    aria-label="Abrir menu"
    aria-controls="primary-nav"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="main-nav" id="primary-nav">
    <a href={isEn ? '/en/' : '/'}>{t.home}</a>

    <!-- Dropdown de Componentes -->
    <div class="dropdown-container">
      <button class="dropdown-toggle" id="componentes-btn">
        {t.components}
        <svg class="dropdown-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 6 8 10.5 12.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="dropdown-menu" id="componentes-menu">
        {categories.map((category) => (
          <a href={category.slug} class="dropdown-item">
            <span class="dropdown-category-symbol">
              <CategoryIcon name={category.icon} />
            </span>
            <span>{category.label}</span>
          </a>
        ))}
      </div>
    </div>

    <a href={isEn ? '/en/recommender/' : '/recomendador/'}>{t.recommender}</a>
    <a href={`${prefix}/blog/`}>{t.blog}</a>
    <a href={`${prefix}/contacto/`}>{t.contact}</a>

    <!-- Lupa: abre el buscador (catálogo primero, luego productos) -->
    <button class="search-btn search-btn--nav" type="button" data-abrir-buscador hidden aria-label={`${t.search} (/)`} title={`${t.search} (/)`} aria-haspopup="dialog" set:html={iconoLupa}></button>

    <!-- Selector de idioma -->
    <div class="lang-switch" aria-label="Idioma / Language">
      <a href={esPath} class={`lang-btn${!isEn ? ' lang-active' : ''}`} title="Español" aria-label="Versión en español">
        <span>ES</span>
      </a>
      <a href={enPath} class={`lang-btn${isEn ? ' lang-active' : ''}`} title="English" aria-label="English version">
        <span>EN</span>
      </a>
    </div>
  </nav>
</header>

<dialog id="buscador" class="buscador" data-lang={isEn ? 'en' : 'es'} aria-label={t.search}>
  <div class="bq-panel">
    <div class="bq-campo">
      <span class="bq-lupa" set:html={iconoLupa}></span>
      <input
        id="buscador-input"
        type="search"
        role="combobox"
        aria-expanded="true"
        aria-controls="buscador-lista"
        aria-autocomplete="list"
        placeholder={t.searchPlaceholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <button type="button" class="bq-cerrar" data-cerrar aria-label={t.close}>Esc</button>
    </div>
    <ul id="buscador-lista" class="bq-lista" role="listbox" aria-label={t.search}></ul>
    <p id="buscador-estado" class="bq-estado" aria-live="polite"></p>
    <p class="bq-pista"><kbd>↑</kbd> <kbd>↓</kbd> {t.hint}</p>
  </div>
</dialog>

<script>
  import '../scripts/buscador.ts';
</script>

<script>
  const btn = document.getElementById('componentes-btn');
  const menu = document.getElementById('componentes-menu');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const nav = document.getElementById('primary-nav');

  const closeMobileMenu = () => {
    if (!mobileToggle || !nav) return;

    mobileToggle.classList.remove('active');
    nav.classList.remove('active');
    mobileToggle.setAttribute('aria-expanded', 'false');
    mobileToggle.setAttribute('aria-label', 'Abrir menu');
  };

  if (btn && menu) {
    // Toggle del menú
    btn.addEventListener('click', () => {
      menu.classList.toggle('active');
    });

    // Cerrar menú al hacer click en un link
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('active');
      });
    });

    // Cerrar menú al hacer click fuera
    document.addEventListener('click', (e) => {
      if (e.target instanceof Node) {
        if (!btn.contains(e.target) && !menu.contains(e.target)) {
          menu.classList.remove('active');
        }
      }
    });
  }

  if (mobileToggle && nav) {
    mobileToggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('active');

      mobileToggle.classList.toggle('active', isOpen);
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobileToggle.setAttribute('aria-label', isOpen ? 'Cerrar menu' : 'Abrir menu');
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Node)) return;

      if (!mobileToggle.contains(e.target) && !nav.contains(e.target)) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMobileMenu();
        menu?.classList.remove('active');
      }
    });
  }
</script>

<style>
  .main-nav {
    z-index: 1000;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    cursor: pointer;
    padding: 10px;
  }

  .menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .menu-toggle span + span {
    margin-top: 6px;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .dropdown-container {
    position: relative;
  }

  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-family: inherit;
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .dropdown-toggle:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }

  .dropdown-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .dropdown-container:has(.dropdown-menu.active) .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: -12px;
    width: min(560px, calc(100vw - 48px));
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    background: var(--navy);
    border: 1px solid rgba(124, 255, 203, 0.2);
    border-radius: var(--r-lg);
    padding: 10px;
    box-shadow: 0 24px 60px -16px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    z-index: 1000;
  }

  .dropdown-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
    font-size: 0.9rem;
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
  }

  .dropdown-category-symbol {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--accent-line);
    border-radius: var(--r-sm);
    color: var(--accent);
    background: var(--accent-soft);
    flex: 0 0 auto;
  }

  .dropdown-category-symbol svg {
    width: 18px;
    height: 18px;
  }

  a.brand {
    text-decoration: none;
    color: inherit;
  }

  /* Lupa */
  .search-btn {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    cursor: pointer;
    transition: background 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .search-btn[hidden] { display: none; }
  .search-btn:hover,
  .search-btn:focus-visible {
    background: rgba(124, 255, 203, 0.2);
    box-shadow: 0 0 0 3px rgba(124, 255, 203, 0.12);
  }
  .search-btn--nav { margin-left: 6px; }
  .search-btn--bar { display: none; margin-left: auto; margin-right: -6px; }

  /* Diálogo del buscador */
  :global(dialog.buscador) {
    width: min(680px, calc(100vw - 24px));
    max-width: none;
    margin: 12vh auto 0;
    padding: 0;
    border: 1px solid rgba(124, 255, 203, 0.22);
    border-radius: var(--r-lg);
    background: #07111d;
    color: var(--text);
    box-shadow: 0 30px 80px -10px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }
  :global(dialog.buscador)::backdrop {
    background: rgba(2, 6, 12, 0.72);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  :global(dialog.buscador[open]) { animation: bq-in 0.18s var(--ease); }
  @keyframes bq-in { from { opacity: 0; transform: translateY(-8px) scale(0.99); } to { opacity: 1; transform: none; } }

  :global(.bq-panel) { display: flex; flex-direction: column; max-height: min(76vh, 640px); }
  :global(.bq-campo) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  :global(.bq-lupa) { color: var(--accent); display: inline-flex; flex: 0 0 auto; }
  :global(.bq-campo input) {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
    -webkit-appearance: none;
    appearance: none;
  }
  :global(.bq-campo input::-webkit-search-cancel-button) { display: none; }
  :global(.bq-campo input::placeholder) { color: var(--text-dim); }
  :global(.bq-cerrar) {
    flex: 0 0 auto;
    padding: 4px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-dim);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }
  :global(.bq-lista) {
    list-style: none;
    margin: 0;
    padding: 6px 8px 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(124, 255, 203, 0.4) transparent;
  }
  :global(.bq-grupo) {
    padding: 12px 10px 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(.bq-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border-radius: var(--r-sm);
    color: var(--text-muted);
    text-decoration: none;
  }
  :global(.bq-item.bq-sel) { background: var(--accent-soft); color: var(--text); }
  :global(.bq-ico) {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    border: 1px solid var(--accent-line);
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  :global(.bq-txt) { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
  :global(.bq-t) { font-size: 0.95rem; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.bq-t mark) { background: transparent; color: var(--accent); font-weight: 700; }
  :global(.bq-s) { font-size: 0.78rem; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.bq-vacio) { padding: 18px 12px; color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; }
  :global(.bq-estado) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: 0; }
  :global(.bq-pista) {
    margin: 0;
    padding: 9px 16px;
    border-top: 1px solid var(--line);
    font-size: 0.74rem;
    color: var(--text-dim);
  }
  :global(.bq-pista kbd) {
    padding: 1px 6px;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    font: inherit;
    font-size: 0.72rem;
  }

  /* Selector de idioma (solo letras ES / EN) */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: 6px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .lang-btn:hover {
    opacity: 1;
    color: #e6f7ff;
  }

  .lang-btn.lang-active {
    opacity: 1;
    color: var(--accent);
    background: var(--accent-soft);
  }


  .brand-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  @keyframes dd-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 1024px) {
    .menu-toggle {
      display: block;
    }

    /* En móvil la lupa va fuera del menú, junto a la hamburguesa */
    .search-btn--nav { display: none; }
    .search-btn--bar { display: inline-grid; }
    .search-btn--bar[hidden] { display: none; }
    :global(dialog.buscador) { margin-top: 8vh; }
    :global(.bq-pista) { display: none; }

    .main-nav {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      left: 0;
      display: grid;
      gap: 6px;
      padding: 16px;
      max-height: calc(100svh - 100px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: rgba(124, 255, 203, 0.4) transparent;
      border: 1px solid rgba(124, 255, 203, 0.18);
      border-radius: var(--r-lg);
      background: var(--navy);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    }

    .main-nav::-webkit-scrollbar {
      width: 6px;
    }

    .main-nav::-webkit-scrollbar-track {
      background: transparent;
    }

    .main-nav::-webkit-scrollbar-thumb {
      background: rgba(124, 255, 203, 0.4);
      border-radius: 999px;
    }

    .main-nav::-webkit-scrollbar-thumb:hover {
      background: rgba(124, 255, 203, 0.65);
    }

    .main-nav.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .main-nav > a,
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: 12px;
      border-radius: 8px;
    }

    .main-nav > a:hover,
    .dropdown-toggle:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    .dropdown-menu {
      position: static;
      min-width: 0;
      width: 100%;
      max-height: 0;
      overflow: hidden;
      padding: 0;
      border: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: block;
      background: rgba(255, 255, 255, 0.03);
    }

    .dropdown-menu.active {
      max-height: min(560px, 55vh);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: rgba(124, 255, 203, 0.4) transparent;
      padding: 6px 0;
      transform: none;
      animation: dd-in 0.22s var(--ease);
    }

    .dropdown-menu.active::-webkit-scrollbar {
      width: 6px;
    }

    .dropdown-menu.active::-webkit-scrollbar-track {
      background: transparent;
    }

    .dropdown-menu.active::-webkit-scrollbar-thumb {
      background: rgba(124, 255, 203, 0.4);
      border-radius: 999px;
    }

    .dropdown-menu.active::-webkit-scrollbar-thumb:hover {
      background: rgba(124, 255, 203, 0.65);
    }

    .dropdown-item {
      padding: 10px 12px;
    }

    .dropdown-item:hover {
      padding-left: 16px;
    }

    .lang-switch {
      justify-self: start;
      margin-top: 6px;
    }
  }
</style>
