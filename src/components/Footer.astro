---
import { CATS_EN, UI_EN, SLUG_EN, toEnPath, toEsPath } from '../i18n/en';

// Idioma derivado de la URL: /en/... es inglés
const pathname = Astro.url.pathname;
const isEn = pathname === '/en' || pathname.startsWith('/en/');
const prefix = isEn ? '/en' : '';

// Rutas equivalentes para el selector de idioma (slugs de categoría traducidos)
const esPath = toEsPath(pathname);
const enPath = toEnPath(esPath);

const catKeys = [
  'tarjetas-graficas', 'procesadores', 'memoria-ram', 'ssd', 'fuentes-de-poder',
  'refrigeracion-liquida', 'refrigeracion-normal', 'gabinetes-gamer', 'teclados', 'mouse', 'audifonos', 'monitores',
];

const labelsEs: Record<string, string> = {
  'tarjetas-graficas': 'Tarjetas gráficas',
  'procesadores': 'Procesadores',
  'memoria-ram': 'Memoria RAM',
  'ssd': 'SSD',
  'fuentes-de-poder': 'Fuentes de poder',
  'refrigeracion-liquida': 'Refrigeración líquida',
  'refrigeracion-normal': 'Refrigeración normal',
  'gabinetes-gamer': 'Gabinetes gamer',
  'teclados': 'Teclados',
  'mouse': 'Mouse',
  'audifonos': 'Audífonos',
  'monitores': 'Monitores',
};

const cats = catKeys.map((key) => ({
  href: isEn ? `/en/${SLUG_EN[key]}/` : `/${key}/`,
  label: isEn ? CATS_EN[key].label : labelsEs[key],
}));

const t = isEn
  ? {
      tagline1: UI_EN.footer.tagline1,
      tagline2: UI_EN.footer.tagline2,
      desc: UI_EN.footer.desc,
      badge: UI_EN.footer.badge,
      catalogs: UI_EN.footer.catalogs,
      info: UI_EN.footer.info,
      blog: 'Blog',
      contact: UI_EN.footer.contact,
      sitemap: UI_EN.footer.sitemap,
      made: UI_EN.footer.made,
      follow: 'Follow us',
      followDesc: 'Deals and Amazon links on our channels',
    }
  : {
      tagline1: 'El setup perfecto',
      tagline2: 'empieza aquí.',
      desc: 'Componentes PC para gaming seleccionados al detalle. Envío rápido vía Amazon.',
      badge: 'Tienda activa · 24/7',
      catalogs: 'Catálogos',
      info: 'Información',
      blog: 'Blog',
      contact: 'Contacto',
      sitemap: 'Mapa del sitio',
      made: 'Hecho para gamers, por gamers',
      follow: 'Síguenos',
      followDesc: 'Ofertas y enlaces de Amazon en nuestros canales',
    };
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-brand-logo">
        <img src="/logo-fondoblanco.png" alt="Monckey Gamer" width="40" height="40" />
        <span>Monckey Gamer</span>
      </div>
      <p class="footer-brand-tagline">{t.tagline1}<br /><em>{t.tagline2}</em></p>
      <p class="footer-brand-desc">{t.desc}</p>
      <div class="footer-brand-badge">
        <span class="badge-dot"></span>
        {t.badge}
      </div>
      <div class="footer-social" aria-label={t.follow}>
        <span class="footer-social-title">{t.follow}</span>
        <p class="footer-social-desc">{t.followDesc}</p>
        <div class="footer-social-links">
          <a href="https://www.tiktok.com/@monckeygamer1" target="_blank" rel="noopener me" aria-label="TikTok @monckeygamer1">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a4.9 4.9 0 0 1-3-1.7 4.9 4.9 0 0 1-1.2-3.1h-3.3v13.3a2.8 2.8 0 1 1-2-2.7V9.2a6.1 6.1 0 1 0 5.3 6V9.4a8.1 8.1 0 0 0 4.7 1.5V7.6a4.9 4.9 0 0 1-.5-.9z"/></svg>
            <span>TikTok</span>
          </a>
          <a href="https://www.youtube.com/@monckeygamer" target="_blank" rel="noopener me" aria-label="YouTube @monckeygamer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
            <span>YouTube</span>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-divider"></div>

    <nav class="footer-nav" aria-label={t.catalogs}>
      <span class="footer-nav-title">{t.catalogs}</span>
      <ul>
        {cats.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-nav" aria-label={t.info}>
      <span class="footer-nav-title">{t.info}</span>
      <ul>
        <li><a href={`${prefix}/blog/`}>{t.blog}</a></li>
        <li><a href={`${prefix}/contacto/`}>{t.contact}</a></li>
        <li><a href="/sitemap.xml">{t.sitemap}</a></li>
      </ul>

      <div class="footer-lang" aria-label="Idioma / Language">
        <a href={esPath} class={`footer-lang-btn${!isEn ? ' footer-lang-active' : ''}`} title="Español">
          Español
        </a>
        <a href={enPath} class={`footer-lang-btn${isEn ? ' footer-lang-active' : ''}`} title="English">
          English
        </a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <span class="footer-copy">© 2026 Monckey Gamer</span>
    <span class="footer-made">{t.made} <span class="footer-heart">▲</span></span>
  </div>
</footer>

<script>
  import '../scripts/fx.ts';
</script>

<style>
  footer {
    position: relative;
    margin-top: 96px;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 1.3fr 0.8fr;
    gap: 48px;
    align-items: start;
    padding: 56px 0 44px;
  }

  .footer-divider {
    display: none;
  }

  /* Marca */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-brand-logo img {
    width: 34px;
    height: 34px;
    border-radius: 9px;
  }

  .footer-brand-logo span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-brand-tagline {
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.12;
    color: var(--text);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .footer-brand-tagline em {
    font-style: normal;
    color: var(--accent);
  }

  .footer-brand-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
    max-width: 34ch;
  }

  .footer-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 12px 5px 10px;
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Redes sociales */
  .footer-social-title {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }

  .footer-social-desc {
    margin: 0 0 12px;
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.5;
    max-width: 34ch;
  }

  .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .footer-social-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.86rem;
    text-decoration: none;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .footer-social-links a:hover,
  .footer-social-links a:focus-visible {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  /* Navegación */
  .footer-nav-title {
    display: block;
    margin-bottom: 18px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  /* El catálogo tiene 12 enlaces: se reparten en dos columnas */
  .footer-nav:nth-of-type(1) ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }

  .footer-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s var(--ease);
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  /* Selector de idioma */
  .footer-lang {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 26px;
  }

  .footer-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }


  .footer-lang-btn:hover { color: var(--text); }
  .footer-lang-active { color: var(--accent); }

  /* Barra inferior */
  .footer-bottom {
    padding: 20px 0 8px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .footer-copy,
  .footer-made {
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  .footer-made {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .footer-heart {
    color: var(--accent);
    font-size: 0.6rem;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 0 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
