---
// Portada del blog (español e inglés): artículo destacado + rejilla de guías con filtro por categoría.
import SiteLayout from './SiteLayout.astro';

interface Articulo { titulo: string; resumen: string; href: string; tag: string; fecha: string; tiempoLectura: string }
interface Props {
  lang?: 'es' | 'en';
  title: string;
  description: string;
  heroTitle: string;
  heroDescription: string;
  articulos: Articulo[];
}

const { lang = 'es', title, description, heroTitle, heroDescription, articulos } = Astro.props;
const isEn = lang === 'en';
const t = isEn
  ? { home: 'Home', blog: 'Blog', all: 'All', guides: 'guides', read: 'read', featured: 'Featured guide', readArticle: 'Read guide', filter: 'Filter guides by category' }
  : { home: 'Inicio', blog: 'Blog', all: 'Todas', guides: 'guías', read: 'de lectura', featured: 'Guía destacada', readArticle: 'Leer guía', filter: 'Filtrar guías por categoría' };

// La guía destacada es la de VRAM (la más buscada); si no existe, la primera
const iDest = Math.max(0, articulos.findIndex((a) => a.href.includes('que-es-la-vram')));
const destacado = articulos[iDest];
const resto = articulos.filter((_, i) => i !== iDest);
const etiquetas = [...new Set(articulos.map((a) => a.tag))];
const site = 'https://monckeygamer.com';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: `${site}${isEn ? '/en/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: t.blog, item: `${site}${isEn ? '/en/blog/' : '/blog/'}` },
  ],
};
---

<SiteLayout title={title} description={description} robots="index, follow" schema={schema}>
  <section class="category-hero">
    <ol class="breadcrumb" aria-label={isEn ? 'Breadcrumb' : 'Migas de pan'}>
      <li><a href={isEn ? '/en/' : '/'}>{t.home}</a></li>
      <li aria-current="page">{t.blog}</li>
    </ol>
    <h1>{heroTitle}</h1>
    <p class="category-description">{heroDescription}</p>
  </section>

  <a class="blog-destacado" href={destacado.href} data-tag={destacado.tag}>
    <div class="blog-destacado-body">
      <span class="blog-destacado-label">{t.featured}</span>
      <h2>{destacado.titulo}</h2>
      <p>{destacado.resumen}</p>
      <div class="blog-card-meta">
        <span class="blog-card-tag">{destacado.tag}</span>
        <span>{destacado.tiempoLectura} {t.read}</span>
      </div>
    </div>
    <span class="blog-destacado-cta">{t.readArticle} →</span>
  </a>

  <div class="blog-filtros" role="group" aria-label={t.filter}>
    <button type="button" class="blog-filtro activo" data-filtro="">{t.all} <small>{articulos.length}</small></button>
    {etiquetas.map((et) => (
      <button type="button" class="blog-filtro" data-filtro={et}>{et} <small>{articulos.filter((a) => a.tag === et).length}</small></button>
    ))}
  </div>

  <section class="blog-grid" id="blog-grid">
    {resto.map((art) => (
      <a class="blog-card" href={art.href} data-tag={art.tag}>
        <span class="blog-card-tag">{art.tag}</span>
        <h2>{art.titulo}</h2>
        <p>{art.resumen}</p>
        <div class="blog-card-meta">
          <span>{art.tiempoLectura} {t.read}</span>
          <span class="blog-card-arrow" aria-hidden="true">→</span>
        </div>
      </a>
    ))}
  </section>
</SiteLayout>

<script>
  // Filtro por categoría sin recargar: los artículos siguen siendo enlaces normales rastreables
  const botones = document.querySelectorAll<HTMLButtonElement>('.blog-filtro');
  const tarjetas = document.querySelectorAll<HTMLElement>('.blog-card');
  const destacado = document.querySelector<HTMLElement>('.blog-destacado');
  botones.forEach((b) => b.addEventListener('click', () => {
    botones.forEach((x) => x.classList.toggle('activo', x === b));
    const f = b.dataset.filtro ?? '';
    tarjetas.forEach((c) => { c.hidden = !!f && c.dataset.tag !== f; });
    if (destacado) destacado.hidden = !!f && destacado.dataset.tag !== f;
  }));
</script>

<style>
  .blog-destacado {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin: 8px 0 28px;
    padding: 36px;
    border-radius: 24px;
    border: 1px solid rgba(124, 255, 203, 0.22);
    background:
      radial-gradient(ellipse 60% 110% at 100% 0%, rgba(0, 255, 225, 0.14), transparent 70%),
      radial-gradient(ellipse 50% 90% at 0% 100%, rgba(124, 255, 203, 0.08), transparent 70%),
      var(--navy);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .blog-destacado:hover { border-color: rgba(124, 255, 203, 0.55); transform: translateY(-2px); }
  .blog-destacado[hidden], .blog-card[hidden] { display: none; }

  .blog-destacado-body { max-width: 62ch; }

  .blog-destacado-label {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .blog-destacado h2 {
    margin: 10px 0 12px;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .blog-destacado p { margin: 0 0 18px; color: var(--text-muted); line-height: 1.7; }

  .blog-destacado-cta {
    flex: none;
    padding: 12px 20px;
    border-radius: 14px;
    background: var(--brand-grad);
    color: #05070b;
    font-weight: 600;
    white-space: nowrap;
  }

  .blog-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
  }

  .blog-filtro {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }

  .blog-filtro small { color: var(--text-dim); font-variant-numeric: tabular-nums; }
  .blog-filtro:hover { border-color: rgba(124, 255, 203, 0.4); color: var(--text); }

  .blog-filtro.activo {
    border-color: var(--accent);
    background: rgba(124, 255, 203, 0.12);
    color: var(--text);
    font-weight: 600;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), background 0.25s var(--ease);
  }

  .blog-card:hover {
    transform: translateY(-3px);
    border-color: rgba(124, 255, 203, 0.4);
    background: rgba(124, 255, 203, 0.05);
  }

  .blog-card-tag {
    align-self: flex-start;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid rgba(124, 255, 203, 0.25);
    background: rgba(124, 255, 203, 0.08);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-card h2 {
    margin: 16px 0 10px;
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .blog-card p {
    flex: 1;
    margin: 0 0 18px;
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-clamp: 3;
    overflow: hidden;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-dim);
    font-size: 0.84rem;
  }

  .blog-destacado .blog-card-meta { justify-content: flex-start; }

  .blog-card-arrow { color: var(--accent); font-size: 1.1rem; transition: transform 0.2s var(--ease); }
  .blog-card:hover .blog-card-arrow { transform: translateX(4px); }

  @media (max-width: 720px) {
    .blog-destacado { flex-direction: column; align-items: flex-start; padding: 24px; }
    .blog-destacado-cta { width: 100%; text-align: center; }
  }
</style>
