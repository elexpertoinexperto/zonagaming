# Los sitemaps se sirven como XML en UTF-8 (Cloudflare solo manda "application/xml" por defecto)
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-pages-es.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-pages-en.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-product-es.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-product-en.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-blog-es.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-blog-en.xml
  Content-Type: application/xml; charset=utf-8

# Índice del buscador: solo lo usa la lupa, no debe indexarse
/buscar-es.json
  X-Robots-Tag: noindex
/buscar-en.json
  X-Robots-Tag: noindex

# La dirección de Pages (zonagaming-1zl.pages.dev y sus previews) sirve la web completa pero NO es la oficial:
# el dominio real es monckeygamer.com. Aquí se pide a los buscadores que no la indexen (el dominio propio no se toca).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
